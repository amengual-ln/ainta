NOTION_TOKEN=
NOTION_SUBSCRIBERS_DB_ID=
NOTION_DISCOVERED_EVENTS_DB_ID=
EVENTBRITE_API_TOKEN=

# Resend (welcome email on newsletter signup)
# Get the API key at https://resend.com/api-keys
# RESEND_FROM must be an address on a domain verified in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM=hola@sparck.com.ar
# Optional address that receives direct replies to manually sent emails.
RESEND_REPLY_TO=hola@sparck.com.ar

# Basic Auth for /app/* and /api/internal/* (ASCII values recommended).
INTERNAL_EMAIL_USER=
INTERNAL_EMAIL_PASSWORD=

# Used in the welcome email: logo image URL and CTA link.
# Override in non-production environments.
SITE_URL=https://sparck.com.ar
